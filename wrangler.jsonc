{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unconvinced-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unconvinced",
      "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create"
    }
  ],
  // Works only after unconvinced.ai shows "Active" in Cloudflare.
  "routes": [
    { "pattern": "unconvinced.ai", "custom_domain": true },
    { "pattern": "www.unconvinced.ai", "custom_domain": true }
  ]
}
